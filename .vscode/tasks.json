{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vue: Watch Build",
      "type": "shell",
      "command": "yarn run dev:ui",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Vue: Build",
      "type": "shell",
      "command": "vbuild.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build All (xbvr.exe)",
      "type": "shell",
      "command": "build_all.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
